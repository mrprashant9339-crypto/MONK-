{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "monk-vercel-preview",
  "main": "workers/monk-vercel-preview.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "preview.monk.monster/*",
      "zone_name": "monk.monster"
    }
  ]
}
